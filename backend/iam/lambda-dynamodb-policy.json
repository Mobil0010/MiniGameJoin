{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MiniGameJoinTableItemAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:TransactWriteItems"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinUsers",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinRooms",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinMatches",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinChatMessages",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinPlayerMatches",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinGameStats",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinFriends"
      ]
    },
    {
      "Sid": "MiniGameJoinQueryAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinChatMessages",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinPlayerMatches",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinGameStats",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinFriends"
      ]
    },
    {
      "Sid": "MiniGameJoinRoomPresenceScan",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinRooms",
        "arn:aws:dynamodb:ap-northeast-2:621641242785:table/MiniGameJoinUsers"
      ]
    }
  ]
}
